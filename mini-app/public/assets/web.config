<?xml version="1.0" encoding="UTF-8"?>
<!--
  Вложенный web.config — переопределяет правило из корневого (см.
  ../web.config) только для этой папки. Здесь лежат js/css с хешем в
  имени файла (index-XXXXX.js) — при каждой пересборке хеш меняется,
  так что кэшировать эти файлы навсегда абсолютно безопасно: старое имя
  просто перестаёт существовать, новое запрашивается заново само собой.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
    </staticContent>
  </system.webServer>
</configuration>
