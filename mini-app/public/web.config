<?xml version="1.0" encoding="UTF-8"?>
<!--
  Скорее всего, реальная причина "иконки/сайт грузятся медленно" — не
  сами файлы (они уже вшиты в бандл и весят копейки), а то, что IIS по
  умолчанию не шлёт заголовки кэширования вообще. Из-за этого браузер
  (и особенно Telegram WebView) может по своей эвристике закэшировать
  СТАРЫЙ index.html и продолжать грузить старую версию сайта — сколько
  бы раз мы ни обновляли файлы на диске. Именно с этим мы уже сталкивались
  раньше в этом чате (история с доменом, который "не обновлялся").

  Этот файл — корневой web.config: запрещает кэшировать index.html и
  всё остальное в корне, чтобы браузер каждый раз проверял свежую версию.
  Для /assets/ (там js/css с хешем в имени файла — при пересборке имя
  меняется само) стоит противоположное правило, см. assets/web.config —
  их наоборот можно кэшировать навсегда, они физически не могут "протухнуть".
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <!--
      SPA-фолбэк: React Router рулит адресной строкой на клиенте (например
      /products/accounts, /admin/products, /purchases/p_xxx) — реальных
      файлов/папок под эти пути на диске нет. Без правила ниже IIS честно
      отдаёт 404 на прямой заход или Ctrl+R/обновление страницы мини-аппа
      на таком адресе. Правило: если запрошенный путь — НЕ существующий
      файл и НЕ существующая папка, отдаём index.html, а дальше уже
      React Router сам разбирает, что показывать. Запросы к реальным
      файлам (index.html, /assets/*.js/css, /icons/*.png и т.п.) это
      правило не трогает — они матчатся как IsFile и проходят как есть.
      Требует установленный на сервере модуль IIS URL Rewrite (обычно уже
      стоит; если его нет — Microsoft раздаёт бесплатно).
    -->
    <rewrite>
      <rules>
        <rule name="SPA fallback to index.html" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
