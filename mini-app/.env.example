# ==========================================================
# Переменные окружения фронтенда (Vite)
# ==========================================================
# ВАЖНО: всё, что попадёт сюда с префиксом VITE_, будет видно
# любому в исходном коде страницы (Просмотр кода / DevTools).
# Сюда можно класть только НЕсекретные, публичные значения:
# адрес API, публичный merchant ID и т.п.
#
# Секретные ключи платёжной системы (API key, secret, webhook
# signing key) сюда НЕ добавляются — они живут только на
# бэкенде, в его собственном .env, который фронтенд никогда
# не видит и не грузит в браузер.
# ==========================================================

# Базовый адрес backend API (старый Express-вариант — сейчас не используется,
# проект перешёл на Supabase, оставлено на случай отката)
VITE_API_BASE_URL=https://api.example.com

# Публичный идентификатор мерчанта/проекта в платёжной системе
# (если платёжный провайдер выдаёт отдельно публичный и секретный ключ)
VITE_PAYMENT_PUBLIC_KEY=

# Включить обращение к реальному API вместо моковых данных
VITE_USE_MOCK=true

# --- Supabase — реальный backend товаров/покупок/баланса ---
# Project URL и anon-ключ из Supabase → Settings → API.
# anon-ключ НЕ секретный, его можно спокойно публиковать во фронтенде.
VITE_SUPABASE_URL=https://ВАШ_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Telegram ID администратора(-ов) — только этим людям будет виден пункт
# "Админ-панель" в профиле. Несколько ID — через запятую, без пробелов.
# Свой Telegram ID можно узнать у бота @userinfobot.
# ВАЖНО: это только скрывает кнопку от обычных покупателей — сама
# админка всё равно защищена паролём на backend (ADMIN_PASSWORD).
VITE_ADMIN_TELEGRAM_IDS=123456789

# Username своего бота (без @), созданного через @BotFather.
VITE_BOT_USERNAME=

# Short name Mini App, заданный в @BotFather командой /newapp
# (по умолчанию используется "shop", можно оставить как есть).
VITE_BOT_APP_SHORTNAME=shop

# Ссылка на чат поддержки — куда попадает покупатель по кнопке
# "Поддержка". Обычно личный @username в Telegram.
VITE_SUPPORT_URL=https://t.me/ВАШ_САППОРТ
